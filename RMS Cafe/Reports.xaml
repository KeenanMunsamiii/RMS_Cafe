<Window x:Class="RMS_Cafe.Reports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RMS_Cafe"
        mc:Ignorable="d"
        Title="RMS Cafe - Reports" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BrandBlack" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BrandGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="TextDark" Color="#333333"/>
        <SolidColorBrush x:Key="TextLight" Color="#888888"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="17,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid Button Style (Gold) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandGold}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Button Style -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ListBoxItem Style for Report Menu -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFF8E7"/>
                                <!-- Light Gold -->
                                <Setter Property="Foreground" Value="{StaticResource BrandGold}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,15"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BrandBlack}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <TextBlock Text="RMS Cafe" Foreground="{StaticResource BrandGold}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Management System" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="Dashboard" Style="{StaticResource SidebarButtonStyle}" Click="NavDashboard_Click"/>
                    <Button Content="POS Terminal" Style="{StaticResource SidebarButtonStyle}" Click="NavPOS_Click"/>
                    <Button Content="Inventory" Style="{StaticResource SidebarButtonStyle}" Click="NavInventory_Click"/>
                    <Button Content="Employees" Style="{StaticResource SidebarButtonStyle}" Click="NavEmployees_Click"/>
                    <Button Content="Reports" Style="{StaticResource SidebarButtonStyle}" Foreground="{StaticResource BrandGold}" Background="#151515" BorderBrush="{StaticResource BrandGold}"/>
                    <Button Content="Payroll (CSV Export)" Style="{StaticResource SidebarButtonStyle}" Click="NavPayroll_Click"/>
                    <Button Content="Audit Logs" Style="{StaticResource SidebarButtonStyle}" Click="NavAuditLogs_Click"/>
                    <Button Content="Settings" Style="{StaticResource SidebarButtonStyle}" Click="NavSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" Padding="25,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reports &amp; Analytics" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Select a report type to view detailed metrics" FontSize="13" Foreground="{StaticResource TextLight}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Admin User" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Text="Administrator" Foreground="{StaticResource TextLight}" FontSize="12" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Reports Content Area -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <!-- Left Menu Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right Data Column -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: Report Selector ListBox -->
                <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10" Margin="0,0,20,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Report Types" FontWeight="SemiBold" Margin="5,5,0,15" Foreground="{StaticResource TextLight}"/>
                        <ListBox x:Name="ReportSelectionBox" BorderThickness="0" Background="Transparent" SelectionChanged="ReportSelectionBox_SelectionChanged">
                            <ListBoxItem Content="Income Generated" IsSelected="True"/>
                            <ListBoxItem Content="Inventory Stats"/>
                            <ListBoxItem Content="Employees Owing"/>
                            <ListBoxItem Content="Comprehensive (All)"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Right Column: Report Display -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar (Filters & Exports) -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker Grid.Column="0" Width="130" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextLight}"/>
                        <DatePicker Grid.Column="2" Width="130" VerticalContentAlignment="Center"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="⬇ Export CSV" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" Click="BtnExportCsv_Click"/>
                            <Button Content="📄 Export PDF" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExportPdf_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Data Tables Container -->
                    <Border Grid.Row="1" Background="White" CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid Margin="5">

                            <!-- 1. Income Report Grid -->
                            <DataGrid x:Name="IncomeGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                                    <DataGridTextColumn Header="Gross Sales" Binding="{Binding GrossSales}" Width="*"/>
                                    <DataGridTextColumn Header="Discounts" Binding="{Binding Discounts}" Width="*"/>
                                    <DataGridTextColumn Header="Net Income" Binding="{Binding NetSales}" Width="*"/>
                                    <DataGridTextColumn Header="Tax" Binding="{Binding Tax}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 2. Inventory Stats Grid (Hidden by default) -->
                            <DataGrid x:Name="InventoryStatsGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="*"/>
                                    <DataGridTextColumn Header="Total Sold" Binding="{Binding TotalSold}" Width="100"/>
                                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="120"/>
                                    <DataGridTextColumn Header="Restock Needed" Binding="{Binding NeedsRestock}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 3. Employees Owing Grid (Hidden by default) -->
                            <DataGrid x:Name="EmployeesOwingGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" Width="*"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                                    <DataGridTextColumn Header="Tab Balance" Binding="{Binding OwedAmount}" Width="120"/>
                                    <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdate}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 4. Placeholder for Comprehensive Report (Hidden by default) -->
                            <TextBlock x:Name="ComprehensiveMsg" Text="Comprehensive report generates a full system PDF combining all metrics. Click 'Export PDF' to generate." 
                                       Foreground="{StaticResource TextLight}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BrandBlack}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📅 25 Jun 2026" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="⏰ 11:15 am" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12" Margin="0,0,30,0"/>
                <TextBlock Grid.Column="3" Text="👤 Role: Administrator" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>