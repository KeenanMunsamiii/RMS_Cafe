<Window x:Class="RMS_Cafe.Dashboard" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:RMS_Cafe"
       mc:Ignorable="d"
        Title="RMS Cafe - Dashboard" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    
    
    
   

        <Window.Resources>
            <SolidColorBrush x:Key="BrandBlack" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="BrandGold" Color="#D4AF37"/>
            <SolidColorBrush x:Key="TextDark" Color="#333333"/>
            <SolidColorBrush x:Key="TextLight" Color="#888888"/>

            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="20,15"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandGold}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BrandBlack}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,30,20,30">
                        <TextBlock Text="RMS Cafe" Foreground="{StaticResource BrandGold}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Management System" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Content="Dashboard" Style="{StaticResource SidebarButtonStyle}" Foreground="{StaticResource BrandGold}" Background="#2A2A2A" Click="NavDashboard_Click"/>
                        <Button Content="POS Terminal" Style="{StaticResource SidebarButtonStyle}" Click="NavPOS_Click"/>
                        <Button Content="Inventory" Style="{StaticResource SidebarButtonStyle}" Click="NavInventory_Click"/>
                        <Button Content="Employees" Style="{StaticResource SidebarButtonStyle}" Click="NavEmployees_Click"/>
                        <Button Content="Reports" Style="{StaticResource SidebarButtonStyle}" Click="NavReports_Click"/>
                        <Button Content="Payroll (CSV Export)" Style="{StaticResource SidebarButtonStyle}" Click="NavPayroll_Click"/>
                        <Button Content="Audit Logs" Style="{StaticResource SidebarButtonStyle}" Click="NavAuditLogs_Click"/>
                        <Button Content="Settings" Style="{StaticResource SidebarButtonStyle}" Click="NavSettings_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20">
                        <Border Background="#2A2A2A" Padding="10" CornerRadius="4" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Secure &amp; Reliable" Foreground="{StaticResource BrandGold}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Your data is protected with role-based access and audit logging." Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="RMS Cafe v1.0.0" Foreground="#666666" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Welcome back, Admin" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Here's what's happening at RMS Cafe." FontSize="14" Foreground="{StaticResource TextLight}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Margin="0,0,20,0" Click="BtnNotifications_Click">
                                <TextBlock Text="🔔" FontSize="20"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Admin User" FontWeight="SemiBold" TextAlignment="Right"/>
                                <TextBlock Text="Administrator" Foreground="{StaticResource TextLight}" FontSize="12" TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="-5,0,-5,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total Sales Today" Foreground="{StaticResource TextLight}"/>
                                <TextBlock Text="R16,457.00" FontSize="24" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="+12.5% from yesterday" Foreground="#27AE60" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Transactions" Foreground="{StaticResource TextLight}"/>
                                <TextBlock Text="39" FontSize="24" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="+8 from yesterday" Foreground="#27AE60" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Products Sold" Foreground="{StaticResource TextLight}"/>
                                <TextBlock Text="248" FontSize="24" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="+15 from yesterday" Foreground="#27AE60" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Low Stock Items" Foreground="{StaticResource TextLight}"/>
                                <TextBlock Text="12" FontSize="24" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="Requires attention" Foreground="#E74C3C" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="-5,0,-5,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel>
                                    <TextBlock Text="Sales Overview" FontWeight="SemiBold" FontSize="16"/>
                                    <ComboBox DockPanel.Dock="Right" Width="100" SelectedIndex="0" HorizontalAlignment="Right" SelectionChanged="CmbChartFilter_SelectionChanged">
                                        <ComboBoxItem Content="This Week"/>
                                        <ComboBoxItem Content="This Month"/>
                                    </ComboBox>
                                </DockPanel>

                                <Canvas Grid.Row="1" Margin="0,20,0,0" Height="200">
                                    <Line X1="50" Y1="0" X2="550" Y2="0" Stroke="#EEEEEE" StrokeThickness="1"/>
                                    <Line X1="50" Y1="50" X2="550" Y2="50" Stroke="#EEEEEE" StrokeThickness="1"/>
                                    <Line X1="50" Y1="100" X2="550" Y2="100" Stroke="#EEEEEE" StrokeThickness="1"/>
                                    <Line X1="50" Y1="150" X2="550" Y2="150" Stroke="#EEEEEE" StrokeThickness="1"/>

                                    <Polyline Points="70,120 140,150 210,180 280,40 350,100 420,130 490,60" Stroke="{StaticResource BrandGold}" StrokeThickness="3" StrokeLineJoin="Round"/>

                                    <Ellipse Canvas.Left="66" Canvas.Top="116" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="136" Canvas.Top="146" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="206" Canvas.Top="176" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="276" Canvas.Top="36" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="346" Canvas.Top="96" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="416" Canvas.Top="126" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                    <Ellipse Canvas.Left="486" Canvas.Top="56" Width="8" Height="8" Fill="{StaticResource BrandGold}"/>
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,15">
                                    <TextBlock Text="System Alerts" FontWeight="SemiBold" FontSize="16"/>
                                    <Button Content="View all" Foreground="{StaticResource BrandGold}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnViewAllAlerts_Click"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Rectangle Width="8" Height="8" Fill="{StaticResource BrandGold}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Low Stock: Americano Beans (500g)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Only 3 units remaining" Foreground="{StaticResource TextLight}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Rectangle Width="8" Height="8" Fill="{StaticResource BrandGold}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Low Stock: Milk Full Cream (1L)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Only 5 units remaining" Foreground="{StaticResource TextLight}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="-5,0,-5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <TextBlock Text="Top Selling Products" FontWeight="SemiBold" FontSize="16"/>
                                </DockPanel>

                                <StackPanel>
                                    <TextBlock Text="1. Cappuccino" Margin="0,5"/>
                                    <TextBlock Text="2. Latte" Margin="0,5"/>
                                    <TextBlock Text="3. Americano" Margin="0,5"/>
                                    <TextBlock Text="4. Mocha" Margin="0,5"/>
                                    <TextBlock Text="5. Flat White" Margin="0,5"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <TextBlock Text="Recent Transactions" FontWeight="SemiBold" FontSize="16"/>
                                    <Button Content="View all" Foreground="{StaticResource BrandGold}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnViewAllTransactions_Click"/>
                                </DockPanel>

                                <DataGrid x:Name="TransactionsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNo}" Width="*"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <TextBlock Text="Employees on Credit" FontWeight="SemiBold" FontSize="16"/>
                                    <Button Content="View all" Foreground="{StaticResource BrandGold}" Background="Transparent" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnViewAllCredit_Click"/>
                                </DockPanel>

                                <StackPanel>
                                    <TextBlock Text="R12,450" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="Total Owing" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,0,0,15"/>

                                    <TextBlock Text="John D." Margin="0,3"/>
                                    <TextBlock Text="Sipho M." Margin="0,3"/>
                                    <TextBlock Text="Thabo K." Margin="0,3"/>
                                    <TextBlock Text="Lebo P." Margin="0,3"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BrandBlack}">
                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📅 25 Jun 2026" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="⏰ 10:41 am" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12" Margin="0,0,30,0"/>
                    <TextBlock Grid.Column="3" Text="👤 Role: Administrator" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Window>